{
  "color": {
    "Black": {
      "$type": "color",
      "$value": "#000000",
      "$description": "All text, nav labels, button borders, link color — the sole foreground color across the entire UI"
    },
    "White": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Primary surface and page background"
    },
    "Off-White Surface": {
      "$type": "color",
      "$value": "#fafafa",
      "$description": "Secondary surface tone used in header/nav area, near-white canvas"
    }
  },
  "typography": {
    "Nav Label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "nb_international_proregular",
        "fontSize": "10.5px",
        "fontWeight": 400,
        "lineHeight": "11.025px",
        "letterSpacing": "0.1575px"
      },
      "$description": "Primary navigation and button labels — uppercase micro-type with tracked letter-spacing"
    },
    "Nav Label Alt": {
      "$type": "typography",
      "$value": {
        "fontFamily": "nb_international_proregular",
        "fontSize": "10.5px",
        "fontWeight": 400,
        "lineHeight": "13px",
        "letterSpacing": "0.1575px"
      },
      "$description": "Alternate nav label line-height variant"
    },
    "Body / UI Text": {
      "$type": "typography",
      "$value": {
        "fontFamily": "nb_international_proregular",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "24px",
        "letterSpacing": "normal"
      },
      "$description": "General UI text, nav container, list items, hero section text"
    },
    "Micro Label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "nb_international_proregular",
        "fontSize": "8.4px",
        "fontWeight": 400,
        "lineHeight": "8.82px",
        "letterSpacing": "0.1575px"
      },
      "$description": "Smallest label tier — metadata or fine-print annotations"
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "7px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "base": {
      "$type": "dimension",
      "$value": "14px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "40px"
    },
    "unit": {
      "$type": "dimension",
      "$value": "1.5px"
    }
  },
  "borderRadius": {
    "Button / Pill": {
      "$type": "dimension",
      "$value": "6px"
    }
  }
}