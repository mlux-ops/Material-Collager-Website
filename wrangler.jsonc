// Cloudflare Workers deployment config (self-hosted; replaces the OpenAI
// Sites hosting). See docs/DEPLOYING.md for the one-time setup steps.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "material-collager",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],

  // The placeholder database_id keeps local dev working (Miniflare ignores
  // it); the deploy workflow resolves the real id from database_name at
  // deploy time via `wrangler d1 list`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "material-collager-db",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],

  "r2_buckets": [
    {
      "binding": "OUTPUTS",
      "bucket_name": "material-collager-outputs"
    }
  ],

  // Cloudflare Images binding used by the /_vinext/image optimizer route.
  "images": {
    "binding": "IMAGES"
  },

  // Workers AI binding used by /api/workbench/inpaint (Masked Edit node's
  // pixel-exact engine, @cf/runwayml/stable-diffusion-v1-5-inpainting).
  // Note: in local dev the AI binding proxies to Cloudflare's network, so it
  // needs a logged-in wrangler session and consumes the account's free-tier
  // neurons even locally.
  "ai": {
    "binding": "AI"
  },

  // Defense-in-depth for Cloudflare Access (see docs/DEPLOYING.md): the
  // Worker rejects any request that bypassed the Access login in front of
  // the workers.dev domain. Values come from Zero Trust -> Access ->
  // Applications -> material-collager -> Overview. Local dev disables the
  // check via blank overrides in .dev.vars (no Access proxy on localhost).
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "dawn-resonance-d86a.cloudflareaccess.com",
    "CF_ACCESS_AUD": "e5e3fd974be8176910f6fc29cbe180b7ebc73d08b2f3475138567f694b559e15"
  },

  "observability": {
    "enabled": true
  }
}
