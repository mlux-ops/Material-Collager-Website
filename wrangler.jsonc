// Cloudflare Workers deployment config (self-hosted; replaces the OpenAI
// Sites hosting). See docs/DEPLOYING.md for the one-time setup steps.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "material-collager",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],

  // The placeholder database_id keeps local dev working (Miniflare ignores
  // it); the deploy workflow resolves the real id from database_name at
  // deploy time via `wrangler d1 list`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "material-collager-db",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],

  "r2_buckets": [
    {
      "binding": "OUTPUTS",
      "bucket_name": "material-collager-outputs"
    }
  ],

  // Cloudflare Images binding used by the /_vinext/image optimizer route.
  "images": {
    "binding": "IMAGES"
  },

  "observability": {
    "enabled": true
  }
}
