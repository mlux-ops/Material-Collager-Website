{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://material-collager.local/schemas/release-collage-rights.schema.json",
  "title": "Material Collager release collage rights manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "collages"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "collages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetKey",
          "title",
          "approvedForPublicPreview",
          "approvedForDownload",
          "rightsBasis",
          "approvedBy",
          "approvedAt",
          "sourceAssets",
          "notes"
        ],
        "properties": {
          "assetKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "approvedForPublicPreview": { "type": "boolean" },
          "approvedForDownload": { "type": "boolean" },
          "rightsBasis": {
            "type": "string",
            "enum": ["owned", "licensed", "permission"]
          },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date-time" },
          "sourceAssets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description", "rightsBasis"],
              "properties": {
                "description": { "type": "string", "minLength": 1 },
                "rightsBasis": {
                  "type": "string",
                  "enum": ["owned", "licensed", "permission"]
                },
                "reference": { "type": "string", "minLength": 1 }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
