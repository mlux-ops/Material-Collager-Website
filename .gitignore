# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/

# local tool/cache output
.pip-temp/
.test-work/
tmp*/
*.pyc
__pycache__/
.local-server*.log
public/screenshot.png

# python package output
*.egg-info/

# Generated release QA evidence (templates remain tracked)
/artifacts/release-qa/*/
!/artifacts/release-qa/templates/
!/artifacts/release-qa/templates/**
