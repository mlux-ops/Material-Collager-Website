# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/

# local tool/cache output
.pip-temp/
.test-work/
tmp*/
*.pyc
__pycache__/
.local-server*.log
public/screenshot.png

# python package output
*.egg-info/

# Generated release QA evidence (templates remain tracked)
/artifacts/release-qa/*/
!/artifacts/release-qa/templates/
!/artifacts/release-qa/templates/**

# VCP / Dev Buddy runtime state (config.json remains tracked)
.vcp/*.log
.vcp/plan/.state/
.vcp/plan/.archive/
.vcp/ralph/

# Pipeline runtime state and quarantined stale git locks
/.task/
/_quarantine/

# Autoboard run output (plans, candidate renders, review sheets)
/autoboard-runs/

# Autoboard's own image overlay for items uploaded via the review UI
/scripts/autoboard/uploaded-images/

# Autoboard's local library of brand-new (not-in-the-manifest) items added
# via the review UI's "Add a new item" card
/scripts/autoboard/custom-items/
